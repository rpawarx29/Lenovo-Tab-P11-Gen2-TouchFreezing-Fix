# Lenovo Tab P11 Gen 2 (TB350XU / TB350FU) - Android 14 S231018 Display & Input Props
# Restores stock 2000ms SurfaceFlinger touch timer while keeping native Settings RR unlocked
windowsmgr.max_events_per_sec=240
ro.surface_flinger.set_touch_timer_ms=2000
ro.surface_flinger.set_idle_timer_ms=1000
debug.sf.disable_backpressure=1
